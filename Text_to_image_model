ons),\n            padding=\"max_length\",\n            truncation=True,\n            max_length=self.max_length,\n            return_tensors=\"pt\",\n        ).to(self.device)\n        out = self.model(**tokens)\n        return out.last_hidden_state, out.pooler_output","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T20:49:00.460609Z","iopub.execute_input":"2026-11-10T20:49:00.461203Z","iopub.status.idle":"2026-11-10T20:49:00.468688Z","shell.execute_reply.started":"2026-11-10T20:49:00.461167Z","shell.execute_reply":"2026-11-10T20:49:00.467771Z"}},"outputs":[{"name":"stdout","text":"Writing /kaggle/working/text2img/src/text_encoder.py\n","output_type":"stream"}],"execution_count":7},{"cell_type":"markdown","source":"### Smoke test","metadata":{}},{"cell_type":"code","source":"import sys\nsys.path.append(\"/kaggle/working/text2img\")\n\nimport torch\nfrom src.text_encoder import FrozenCLIPTextEncoder\n\ndevice = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nencoder = FrozenCLIPTextEncoder().to(device)\n\ncaptions = [\"a photo of a sneaker\", \"a photo of a sandal\", \"a photo of a trouser\", \"a photo of a dress\"]\nseq, pooled = encoder(captions)\n\nprint(\"Sequence:\", seq.shape)    # [4, 16, 512]\nprint(\"Pooled:  \", pooled.shape) # [4, 512]\nprint(\"Trainable params:\", sum(p.requires_grad for p in encoder.parameters()))  # 0\nprint(\"Training mode:\", encoder.model.training)                                  # False\n\n# Do the embeddings capture meaning? Compare caption similarities.\np = torch.nn.functional.normalize(pooled, dim=-1)\nprint((p @ p.T).cpu().numpy().round(2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T20:49:05.303534Z","iopub.execute_input":"2026-11-10T20:49:05.304663Z","iopub.status.idle":"2026-11-10T20:49:52.912497Z","shell.execute_reply.started":"2026-11-10T20:49:05.304628Z","shell.execute_reply":"2026-11-10T20:49:52.911463Z"}},"outputs":[{"output_type":"display_data","data":{"text/pla