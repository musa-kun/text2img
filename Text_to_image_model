orchvision import datasets, transforms\n\nCLASS_NAMES = [\n    \"t-shirt\", \"trouser\", \"pullover\", \"dress\", \"coat\",\n    \"sandal\", \"shirt\", \"sneaker\", \"bag\", \"ankle boot\",\n]\n\nCAPTION_TEMPLATES = [\n    \"a photo of a {}\",\n    \"an image of a {}\",\n    \"a small picture of a {}\",\n    \"a grayscale {}\",\n    \"{}\",\n]\n\n\nclass CaptionedFashionMNIST(Dataset):\n    \"\"\"Fashion-MNIST images paired with template-generated text captions.\n\n    Returns:\n        image:   FloatTensor of shape (1, image_size, image_size), values in [-1, 1]\n        caption: str, e.g. \"a photo of a sneaker\"\n    \"\"\"\n\n    def __init__(\n        self,\n        root: str = \"./data\",\n        train: bool = True,\n        image_size: int = 32,\n        random_flip: bool = True,\n        download: bool = True,\n    ):\n        tfms = [transforms.Resize(image_size)]\n        if random_flip and train:\n            tfms.append(transforms.RandomHorizontalFlip())\n        tfms += [\n            transforms.ToTensor(),                      # [0, 1]\n            transforms.Normalize((0.5,), (0.5,)),       # -> [-1, 1]\n        ]\n        self.base = datasets.FashionMNIST(\n            root=root, train=train, download=download,\n            transform=transforms.Compose(tfms),\n        )\n\n    def __len__(self) -> int:\n        return len(self.base)\n\n    def __getitem__(self, idx: int) -> Tuple[torch.Tensor, str]:\n        image, label = self.base[idx]\n        template = random.choice(CAPTION_TEMPLATES)\n        caption = template.format(CLASS_NAMES[label])\n        return image, caption\n\n\ndef get_dataloader(\n    root: str = \"./data\",\n    train: bool = True,\n    image_size: int = 32,\n    batch_size: int = 128,\n    num_workers: int = 2,\n) -> DataLoader:\n    dataset = CaptionedFashionMNIST(root=root, train=train, image_size=image_size)\n    return DataLoader(\n        dataset,\n        batch_size=batch_size,\n        shuffle=train,\n        num_workers=num_workers,\n        pin_memory=torch.cuda.is_available(),\n        drop_last=train,\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T20:43:03.897274Z","iopub.execute_input":"2026-11-10T20:43:03.897721Z","iopub.status.idle":"2026-11-10T20:43:03.904298Z","shell.execute_reply.started":"2026-11-10T20:43:03.89769Z","shell.execute_reply":"2026-11-10T20:43:03.90332Z"}},"outputs":[{"name":"stdout","text":"Overwriting /kaggle/working/text2img/src/dataset.py\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":"### Smoke test","metadata":{}},{"cell_type":"code","source":"import sys\nsys.path.append(\"/kaggle/working/text2img\")\n\nimport matplotlib.pyplot as plt\nfrom src.dataset import get_dataloader\n\nloader = get_dataloader(root=\"/kaggle/working/data\", batch_size=16)\nimages, captions = next(iter(loader))\n\nprint(\"Image batch:\", images.shape, images.dtype)        # [16, 1, 32, 32]\nprint(\"Value range:\", images.min().item(), images.max().item())  # about -1 to 1\nprint(\"Sample captions:\", captions[:4])\n\nfig, axes = plt.subplots(2, 8, figsize=(16, 4.5))\nfor ax, img, cap in zip(axes.flat, images, captions):\n    ax.imshow((img.squeeze() + 1) / 2, cmap=\"gray\")   # un-normalize for display\n    ax.set_title(cap, fontsize=7)\n    ax.axis(\"off\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T20:48:47.321817Z","iopub.execute_input":"2026-11-10T20:48:47.322101Z","iopub.status.idle":"2026-11-10T20:48:54.186948Z","shell.execute_reply.started":"2026-11-10T20:48:47.322075Z","shell.execute_reply":"2026-11-10T20:48:54.18591Z"}},"outputs":[{"name":"stderr","text":"100%|██████████| 26.4M/26.4M [00:01<00:00, 17.0MB/s]\n100%|██████████| 29.5k/29.5k [00:00<00:00, 265kB/s]\n100%|██████████| 4.42M/4.42M [00:00<00:00, 5.01MB/s]\n100%|██████████| 5.15k/5.15k [00:00<00:00, 14.5MB/s]\n","output_type":"stream"},{"name":"stdout","text":"Image batch: torch.Size([16, 1