> torch.Tensor:\n        \"\"\"Pick values[t] per sample and reshape to (B, 1, 1, 1) for broadcasting.\"\"\"\n        return values[t].reshape(-1, 1, 1, 1)\n\n    def add_noise(self, x0: torch.Tensor, t: torch.Tensor, noise: torch.Tensor = None):\n        \"\"\"Forward process. Returns (x_t, noise). t has shape (B,), dtype long.\"\"\"\n        if noise is None:\n            noise = torch.randn_like(x0)\n        x_t = (\n            self._gather(self.sqrt_alpha_bars, t) * x0\n            + self._gather(self.sqrt_one_minus_alpha_bars, t) * noise\n        )\n        return x_t, noise\n\n    @torch.no_grad()\n    def step(self, eps_pred: torch.Tensor, t: int, x_t: torch.Tensor) -> torch.Tensor:\n        \"\"\"One reverse step x_t -> x_{t-1}. t is a single Python int.\"\"\"\n        beta = self.betas[t]\n        alpha = self.alphas[t]\n        mean = (x_t - beta / self.sqrt_one_minus_alpha_bars[t] * eps_pred) / alpha.sqrt()\n        if t == 0:\n            return mean                       # no noise on the final step\n        noise = torch.randn_like(x_t)\n        return mean + self.posterior_variance[t].sqrt() * noise","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T20:51:05.490072Z","iopub.execute_input":"2026-11-10T20:51:05.490611Z","iopub.status.idle":"2026-11-10T20:51:05.497673Z","shell.execute_reply.started":"2026-11-10T20:51:05.490577Z","shell.execute_reply":"2026-11-10T20:51:05.496762Z"}},"outputs":[{"name":"stdout","text":"Overwriting /kaggle/working/text2img/src/scheduler.py\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"%%writefile /kaggle/working/text2img/src/sampling.py\n\"\"\"Image generation: run the reverse diffusion loop with classifier-free guidance.\"\"\"\nfrom typing import List\n\nimport torch\n\n\n@torch.no_grad()\ndef sample(\n    model,\n    scheduler,\n    text_encoder,\n    captions: List[str],\n    image_size: int = 32,\n    channels: int = 1,\n    guidance_scale: float = 3.0,\n    device: str = \"cuda\",\n) -> torch.Tensor:\n    \"\"\"Generate one image per caption. Returns a tensor in [-1, 1], shape (B,C,H,W).\"\"\"\n    was_training = model.training\n    model.eval()\n\n    b = len(captions)\n    _, cond = text_encoder(captions)                 # (B, 512)\n    _, uncond = text_encoder([\"\"] * b)               # (B, 512) null caption\n\n    x = torch.randn(b, channels, image_size, image_size, device=device)\n    for t in reversed(range(scheduler.num_timesteps)):\n        t_batch = torch.full((b,), t, device=device, dtype=torch.long)\n        # One forward pass for both conditional and unconditional predictions.\n        eps = model(\n            torch.cat([x, x]), torch.cat([t_batch, t_batch]), torch.cat([cond, uncond])\n        )\n        eps_cond, eps_uncond = eps.chunk(2)\n        eps = eps_uncond + guidance_scale * (eps_cond - eps_uncond)\n        x = scheduler.step(eps, t, x)\n\n    if was_training:\n        model.train()\n    return x.clamp(-1, 1)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T20:51:10.86981Z","iopub.execute_input":"2026-11-10T20:51:10.870284Z","iopub.status.idle":"2026-11-10T20:51:10.876271Z","shell.execute_reply.started":"2026-11-10T20:51:10.870252Z","shell.execute_reply":"2026-11-10T20:51:10.875305Z"}},"outputs":[{"name":"stdout","text":"Writing /kaggle/working/text2img/src/sampling.py\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"import sys\nsys.path.append(\"/kaggle/working/text2img\")\n\nimport torch\nimport matplotlib.pyplot as plt\nfrom src.dataset import get_dataloader\nfrom src.scheduler import DDPMScheduler\n\ndevice = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nscheduler = DDPMScheduler().to(device)\n\nloader = get_dataloader(root=\"/kaggle/working/data\", batch_size=64)\nimages, captions = next(iter(loader))\nimages = images.to(device)\n\nprint(\"sqrt(alpha_bar) at t=0, 250, 500, 750, 999:\",\n      [round(scheduler.sqrt_alpha_bars[t].item(), 