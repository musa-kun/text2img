{"duration":0.012023,"end_time":"2026-11-10T22:36:02.754962+00:00","exception":false,"start_time":"2026-11-10T22:36:02.742939+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /kaggle/working/text2img/src/dataset.py\n"]}],"source":["%%writefile /kaggle/working/text2img/src/dataset.py\n","\"\"\"Dataset and DataLoader utilities for text-conditioned Fashion-MNIST.\"\"\"\n","import random\n","from typing import Tuple\n","\n","import torch\n","from torch.utils.data import Dataset, DataLoader\n","from torchvision import datasets, transforms\n","\n","CLASS_NAMES = [\n","    \"t-shirt\", \"trouser\", \"pullover\", \"dress\", \"coat\",\n","    \"sandal\", \"shirt\", \"sneaker\", \"bag\", \"ankle boot\",\n","]\n","\n","CAPTION_TEMPLATES = [\n","    \"a photo of a {}\",\n","    \"an image of a {}\",\n","    \"a small picture of a {}\",\n","    \"a grayscale {}\",\n","    \"{}\",\n","]\n","\n","\n","class CaptionedFashionMNIST(Dataset):\n","    \"\"\"Fashion-MNIST images paired with template-generated text captions.\n","\n","    Returns:\n","        image:   FloatTensor of shape (1, image_size, image_size), values in [-1, 1]\n","        caption: str, e.g. \"a photo of a sneaker\"\n","    \"\"\"\n","\n","    def __init__(\n","        self,\n","        root: str = \"./data\",\n","        train: bool = True,\n","        image_size: int = 32,\n","        random_flip: bool = True,\n","        download: bool = True,\n","    ):\n","        tfms = [transforms.Resize(image_size)]\n","        if random_flip and train:\n","            tfms.append(transforms.RandomHorizontalFlip())\n","        tfms += [\n","            transforms.ToTensor(),                      # [0, 1]\n","            transforms.Normalize((0.5,), (0.5,)),       # -> [-1, 1]\n","        ]\n","        self.base = datasets.FashionMNIST(\n","            root=root, train=train, download=download,\n","            transform=transforms.Compose(tfms),\n","        )\n","\n","    def __len__(self) -> int:\n","        return len(self.base)\n","\n","    def __getitem__(self, idx: int) -> Tuple[torch.Tensor, str]:\n","        image, label = self.base[idx]\n","        template = random.choice(CAPTION_TEMPLATES)\n","        caption = template.format(CLASS_NAMES[label])\n","        return image, caption\n","\n","\n","def get_dataloader(\n","    root: str = \"./data\",\n","    train: bool = True,\n","    image_size: int = 32,\n","    batch_size: int = 128,\n","    num_workers: int = 2,\n",") -> DataLoader:\n","    dataset = CaptionedFashionMNIST(root=root, train=train, image_size=image_size)\n","    return DataLoader(\n","        dataset,\n","        batch_size=batch_size,\n","        shuffle=train,\n","        num_workers=num_workers,\n","        pin_memory=torch.cuda.is_available(),\n","        drop_last=train,\n","    )"]},{"cell_type":"markdown","id":"d0db3e01","metadata":{"papermill":{"duration":0.002612,"end_time":"2026-11-10T22:36:02.760606+00:00","exception":false,"start_time":"2026-11-10T22:36:02.757994+00:00","status":"completed"},"tags":[]},"source":["### Smoke test"]},{"cell_type":"code","execution_count":4,"id":"ae5ad415","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:36:02.767012Z","iopub.status.busy":"2026-11-10T22:36:02.766713Z","iopub.status.idle":"2026-11-10T22:36:05.449436Z","shell.execute_reply":"2026-11-10T22:36:05.448518Z"},"papermill":{"duration":2.688258,"end_time":"2026-11-10T22:36:05.451538+00:00","exception":false,"start_time":"2026-11-10T22:36:02.76328+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["100%|██████████| 26.4M/26.4M [00:00<00:00, 116MB/s]\n","100%|██████████| 29.5k/29.5k [00:00<00:00, 3.78MB/s]\n","100%|██████████| 4.42M/4.42M [00:00<00:00, 52.0MB/s]\n","100%|██████████| 5.15k/5.15k [00:00<00:00, 13.6MB/s]\n"]},{"name":"stdout","output_type":"stream","text":["Image batch: torch.Size([16, 1, 32, 32]) torch.float32\n","Value range: -1.0 0.