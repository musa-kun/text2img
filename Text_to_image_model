rocess adds tiny amounts of noise "]},{"cell_type":"code","execution_count":10,"id":"2f342f5b","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:37:03.400297Z","iopub.status.busy":"2026-11-10T22:37:03.399281Z","iopub.status.idle":"2026-11-10T22:37:03.406272Z","shell.execute_reply":"2026-11-10T22:37:03.405331Z"},"papermill":{"duration":0.015213,"end_time":"2026-11-10T22:37:03.408004+00:00","exception":false,"start_time":"2026-11-10T22:37:03.392791+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /kaggle/working/text2img/src/scheduler.py\n"]}],"source":["%%writefile /kaggle/working/text2img/src/scheduler.py\n","\"\"\"DDPM noise scheduler: forward noising and one reverse denoising step.\"\"\"\n","import torch\n","import torch.nn as nn\n","\n","\n","class DDPMScheduler(nn.Module):\n","    \"\"\"Holds the noise schedule as buffers (so .to(device) moves them too).\"\"\"\n","\n","    def __init__(\n","        self,\n","        num_timesteps: int = 1000,\n","        beta_start: float = 1e-4,\n","        beta_end: float = 0.02,\n","    ):\n","        super().__init__()\n","        self.num_timesteps = num_timesteps\n","\n","        betas = torch.linspace(beta_start, beta_end, num_timesteps)\n","        alphas = 1.0 - betas\n","        alpha_bars = torch.cumprod(alphas, dim=0)\n","        alpha_bars_prev = torch.cat([torch.ones(1), alpha_bars[:-1]])\n","        posterior_variance = betas * (1.0 - alpha_bars_prev) / (1.0 - alpha_bars)\n","\n","        self.register_buffer(\"betas\", betas)\n","        self.register_buffer(\"alphas\", alphas)\n","        self.register_buffer(\"alpha_bars\", alpha_bars)\n","        self.register_buffer(\"sqrt_alpha_bars\", alpha_bars.sqrt())\n","        self.register_buffer(\"sqrt_one_minus_alpha_bars\", (1.0 - alpha_bars).sqrt())\n","        self.register_buffer(\"posterior_variance\", posterior_variance)\n","\n","    @staticmethod\n","    def _gather(values: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n","        \"\"\"Pick values[t] per sample and reshape to (B, 1, 1, 1) for broadcasting.\"\"\"\n","        return values[t].reshape(-1, 1, 1, 1)\n","\n","    def add_noise(self, x0: torch.Tensor, t: torch.Tensor, noise: torch.Tensor = None):\n","        \"\"\"Forward process. Returns (x_t, noise). t has shape (B,), dtype long.\"\"\"\n","        if noise is None:\n","            noise = torch.randn_like(x0)\n","        x_t = (\n","            self._gather(self.sqrt_alpha_bars, t) * x0\n","            + self._gather(self.sqrt_one_minus_alpha_bars, t) * noise\n","        )\n","        return x_t, noise\n","\n","    @torch.no_grad()\n","    def step(self, eps_pred: torch.Tensor, t: int, x_t: torch.Tensor) -> torch.Tensor:\n","        \"\"\"One reverse step x_t -> x_{t-1}. t is a single Python int.\"\"\"\n","        beta = self.betas[t]\n","        alpha = self.alphas[t]\n","        mean = (x_t - beta / self.sqrt_one_minus_alpha_bars[t] * eps_pred) / alpha.sqrt()\n","        if t == 0:\n","            return mean                       # no noise on the final step\n","        noise = torch.randn_like(x_t)\n","        return mean + self.posterior_variance[t].sqrt() * noise"]},{"cell_type":"code","execution_count":11,"id":"77dd5921","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:37:03.420327Z","iopub.status.busy":"2026-11-10T22:37:03.419978Z","iopub.status.idle":"2026-11-10T22:37:03.42642Z","shell.execute_reply":"2026-11-10T22:37:03.425418Z"},"papermill":{"duration":0.01462,"end_time":"2026-11-10T22:37:03.428054+00:00","exception":false,"start_time":"2026-11-10T22:37:03.413434+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /kaggle/working/text2img/src/sampling.py\n"]}],"source":["%%writefile /kaggle/working/text2img/src/sampling.py\n","\"\"\"Image generation: run the reverse diffusion loop with classifier-free guidance.\"\"\"\n","from typing import List\n","\n","import torch\n","\n","\n","@torch.no_grad()\n","def sample(\n","    model,\n","    scheduler,\n","    text_encoder,\n","    captions: List[str],\n","    image_size: int = 32,\n","    channels: int = 1,\n","    guidance_scale: float = 3.0,\n","    device: str = \"cuda\",\n",") -> torch.Tensor:\n","    \"\"\"Generate one image per caption. Returns a tensor in [-1, 1], shape (B,C,H,W).\"\"\"\n","    was_training = model.training\n","    model.eval()\n","\n","    b = len(captions)\n","    _, cond = text_encoder(captions)                 # (B, 512)\n","    _, uncond = text_encoder([\"\"] * b)               # (B, 512) null caption\n","\n","    x = torch.randn(b, channels, image_size, image_size, device=device)\n","    for t in reversed(range(scheduler.num_timesteps)):\n","        t_batch = torch.full((b,), t, device=device, dtype=torch.long)\n","        # One forward pass for both conditional and unconditional predictions.\n","        eps = model(\n","            torch.cat([x, x]), torch.cat([t_batch, t_batch]), torch.cat([cond, uncond])\n","        )\n","        eps_cond, eps_uncond = eps.chunk(2)\n","        eps = eps_uncond + guidance_scale * (eps_cond - eps_uncond)\n","        x = scheduler.step(eps, t, x)\n","\n","    if was_training:\n","        model.train()\n","    return x.clamp(-1, 1)"]},{"cell_type":"code","execution_count":12,"id":"f610a1dd","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:37:03.439985Z","iopub.status.busy":"2026-11-10T22:37:03.439713Z","iopub.status.idle":"2026-11-10T22:37:04.757627Z","shell.execute_reply":"2026-11-10T22:37:04.756665Z"},"papermill":{"duration":1.32676,"end_time":"2026-11-10T22:37:04.760201+00:00","exception":false,"start_time":"2026-11-10T22:37:03.433441+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["sqrt(alpha_bar) at t=0, 250, 500, 750, 999: [0.9999, 0.7221, 0.2789, 0.0574, 0.0064]\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1400x800 with 28 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["import sys\n","sys.path.append(\"/kaggle/working/text2img\")\n","\n","import torch\n","import matplotlib.pyplot as plt\n","from src.dataset import get_dataloader\n","from src.scheduler import DDPMScheduler\n","\n","device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","scheduler = DDPMScheduler().to(device)\n","\n","loader = get_dataloader(root=\"/kaggle/working/data\", batch_size=64)\n","images, captions = next(iter(loader))\n","images = images.to(device)\n","\n","print(\"sqrt(alpha_bar) at t=0, 250, 500, 750, 999:\",\n","      [round(scheduler.sqrt_alpha_bars[t].item(), 4) for t in (0, 250, 500, 750, 999)])\n","\n","timesteps = [0, 50, 150, 300, 500, 750, 999]\n","fig, axes = plt.subplots(4, len(timesteps), figsize=(2 * len(timesteps), 8))\n","for row in range(4):\n","    for col, tt in enumerate(timesteps):\n","        t = torch.full((1,), tt, device=device, dtype=torch.long)\n","        noisy, _ = scheduler.add_noise(images[row:row + 1], t)\n","        axes[row, col].imshow(noisy[0, 0].cpu().clamp(-1, 1), cmap=\"gray\", vmin=-1, vmax=1)\n","        axes[row, col].axis(\"off\")\n","        if row == 0:\n","            axes[row, col].set_title(f\"t={tt}\")\n","plt.tight_layout(); plt.show()"]},{"cell_type":"code","execution_count":13,"id":"28b96c8c","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:37:04.775285Z","iopub.status.busy":"2026-11-10T22:37:04.774798Z","iopub.status.idle":"2026-11-10T22:37:04.94396Z","shell.execute_reply":"2026-11-10T22:37:04.943029Z"},"papermill":{"duration":0.178458,"end_time":"2026-11-10T22:37:04.945817+00:00","exception":false,"start_time":"2026-11-10T22:37:04.767359+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["t=750: implied noise mean +0.000, std 1.004\n","t=500: implied noise mean -0.004, std 0.996\n","t=250: implied noise mean -0.011, std 0.997\n","t=100: implied noise mean -0.014, std 0.998\n"]}],"source":["x0 = images                                  # 64 real images (65,536 pixels total)\n","x = torch.randn_like(x0)                     # start from pure noise\n","checks = {750, 500, 250, 100}\n","\n","for t in reversed(range(scheduler.num_timesteps)):\n","    # Oracle: the exact noise implied by (x_t, x0)\n","    eps = (x - scheduler.sqrt_alpha_bars[t] * x0) / scheduler.sqrt_one_minus_alpha_bars[t]\n","    x = scheduler.step(eps, t, x)\n","    if (t - 1) in checks:\n","        s = t - 1\n","        implied = (x - scheduler.sqrt_alpha_bars[s] * x0) / scheduler.sqrt_one_minus_alpha_bars[s]\n","        print(f\"t={s:3d}: implied noise mean {implied.mean().item():+.3f}, std {implied.std().item():.3f}\")"]},{"cell_type":"markdown","id":"4c53ec15","metadata":{"papermill":{"duration":0.006409,"end_time":"2026-11-10T22:37:04.95863+00:00","exception":false,"start_time":"2026-11-10T22:37:04.952221+00:00","status":"completed"},"tags":[]},"source":["## Phase 5: Training Loop, Logging, Checkpoints & Samples "]},{"cell_type":"code","execution_count":14,"id":"85c44dbb","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:37:04.972367Z","iopub.status.busy":"2026-11-10T22:37:04.972001Z","iopub.status.idle":"2026-11-10T22:37:04.978631Z","shell.execute_reply":"2026-11-10T22:37:04.977816Z"},"papermill":{"duration":0.015533,"end_time":"2026-11-10T22:37:04.980302+00:00","exception":false,"start_time":"2026-11-10T22:37:04.964769+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /kaggle/working/text2img/src/utils.py\n"]}],"source":["%%writefile /kaggle/working/text2img/src/utils.py\n","\"\"\"Training helpers: seeding, EMA, checkpoints, image grids, loss plots.\"\"\"\n","import copy\n","import os\n","import random\n","\n","import numpy as np\n","import torch\n","import torch.nn.functional as F\n","from torchvision.utils import save_image\n","\n","\n","def set_seed(seed: int) -> None:\n","    random.seed(seed)\n","    np.random.seed(seed)\n","    torch.manual_seed(seed)\n","    torch.cuda.manual_seed_all(seed)\n","\n","\n","class EMA:\n","    \"\"\"Exponential moving average of a model's weights (kept as a separate model).\"\"\"\n","\n","    def __init__(self, model: torch.nn.Module, decay: float = 0.999):\n","        self.decay = decay\n","        self.num_updates = 0\n","        self.model = copy.deepcopy(model).eval()\n","        for p in self.model.parameters():\n","            p.requires_grad_(False)\n","\n","    @torch.no_grad()\n","    def update(self, model: torch.nn.Module) -> None:\n","        self.num_updates += 1\n","        d = min(self.decay, (1 + self.num_updates) / (10 + self.num_updates))\n","        for ema_p, p in zip(self.model.parameters(), model.parameters()):\n","            ema_p.mul_(d).add_(p.detach(), alpha=1 - d)\n","\n","\n","def save_checkpoint(path, model, ema, optimizer, step, completed_epochs, history):\n","    os.makedirs(os.path.dirname(path), exist_ok=True)\n","    tmp = path + \".tmp\"\n","    torch.save(\n","        {\n","            \"model\": model.state_dict(),\n","            \"ema\": ema.model.state_dict(),\n","            \"optimizer\": optimizer.state_dict(),\n","            \"step\": step,\n","            \"completed_epochs\": completed_epochs,\n","            \"history\": history,\n","        },\n","        tmp,\n","    )\n","    os.replace(tmp, path)  # atomic: an interrupted save can't corrupt the old file\n","\n","\n","def load_checkpoint(path, model, ema, optimizer, device):\n","    ckpt = torch.load(path, map_location=device)\n","    model.load_state_dict(ckpt[\"model\"])\n","    ema.model.load_state_dict(ckpt[\"ema\"])\n","    optimizer.load_state_dict(ckpt[\"optimizer\"])\n","    ema.num_updates = ckpt[\"step\"]\n","    return ckpt[\"step\"], ckpt[\"completed_epochs\"], ckpt[\"history\"]\n","\n","\n","def save_sample_grid(images: torch.Tensor, path: str, nrow: int = 10, scale: int = 4) -> None:\n","    \"\"\"Save images in [-1, 1] as an upscaled PNG grid.\"\"\"\n","    os.makedirs(os.path.dirname(path) or \".\", exist_ok=True)\n","    images = (images.detach().cpu() + 1) / 2\n","    images = F.interpolate(images, scale_factor=scale, mode=\"nearest\")\n","    save_image(images, path, nrow=nrow, padding=2)\n","\n","\n","def plot_loss(history, path=None) -> None:\n","    import matplotlib.pyplot as plt\n","\n","    steps = [h[\"step\"] for h in history]\n","    losses = [h[\"loss\"] for h in history]\n","    plt.figure(figsize=(7, 4))\n","    plt.plot(steps, losses)\n","    plt.yscale(\"log\")\n","    plt.xlabel(\"step\")\n","    plt.ylabel(\"training loss (MSE)\")\n","    plt.title(\"Training loss\")\n","    plt.grid(alpha=0.3)\n","    plt.tight_layout()\n","    if path:\n","        plt.savefig(path, dpi=150)\n","    plt.show()"]},{"cell_type":"code","execution_count":15,"id":"59417af7","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:37:04.994604Z","iopub.status.busy":"2026-11-10T22:37:04.994371Z","iopub.status.idle":"2026-11-10T22:37:05.000769Z","shell.execute_reply":"2026-11-10T22:37:05.000042Z"},"papermill":{"duration":0.015509,"end_time":"2026-11-10T22:37:05.002414+00:00","exception":false,"start_time":"2026-11-10T22:37:04.986905+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing /kaggle/working/text2img/src/train.py\n"]}],"source":["%%writefile /kaggle/working/text2img/src/train.py\n","\"\"\"Train the text-conditioned diffusion model on captioned Fashion-MNIST.\n","\n","Run from the repo root:  python -m src.train --epochs 30\n","\"\"\"\n","import argparse\n","import json\n","import os\n","import random\n","import time\n","\n","import torch\n","import torch.nn.functional as F\n","\n","from src.dataset import CLASS_NAMES, get_dataloader\n","from src.model import MiniUNet\n","from src.sampling import sample\n","from src.scheduler import DDPMScheduler\n","from src.text_encoder import FrozenCLIPTextEncoder\n","from src.utils import (\n","    EMA, load_checkpoint, plot_loss, save_checkpoint, save_sample_grid, set_seed,\n",")\n","\n","\n","def parse_args(argv=None):\n","    p = argparse.ArgumentParser(description=\"Train a tiny text-to-image diffusion model\")\n","    p.add_argument(\"--data_dir\", default=\"./data\")\n","    p.add_argument(\"--out_dir\", default=\"./outputs\")\n","    p.add_argument(\"--epochs\", type=int, default=30)\n","    p.add_argument(\"--batch_size\", type=int, default=128)\n","    p.add_argument(\"--lr\", type=float, default=2e-4)\n","    p.add_argument(\"--ema_decay\", type=float, default=0.999)\n","    p.add_argument(\"--p_uncond\", type=float, default=0.1, help=\"caption dropout probability\")\n","    p.add_argument(\"--guidance_scale\", type=float, default=3.0)\n","    p.add_argument(\"--sample_every\", type=int, default=5, help=\"epochs between sample grids\")\n","    p.add_argument(\"--log_every\", type=int, default=200, help=\"steps between loss logs\")\n","    p.add_argument(\"--seed\", type=int, default=42)\n","    p.add_argument(\"--resume\", action=\"store_true\")\n","    return p.parse_args(argv)\n","\n","\n","def generate_grid(ema_model, scheduler, text_encoder, cfg, device, path):\n","    \"\"\"Two rows of samples, one column per class, always from the same start noise.\"\"\"\n","    prompts = [f\"a photo of a {c}\" for c in CLASS_NAMES] * 2\n","    devices = [torch.cuda.current_device()] if device.type == \"cuda\" else []\n","    with torch.random.fork_rng(devices=devices):   # don't disturb training's RNG\n","        torch.manual_seed(1234)\n","        images = sample(\n","            ema_model, scheduler, text_encoder, prompts,\n","            guidance_scale=cfg.guidance_scale, device=str(device),\n","        )\n","    save_sample_grid(images, path, nrow=len(CLASS_NAMES))\n","\n","\n","def main(argv=None):\n","    cfg = parse_args(argv)\n","    set_seed(cfg.seed)\n","    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","    ckpt_dir = os.path.join(cfg.out_dir, \"checkpoints\")\n","    sample_dir = os.path.join(cfg.out_dir, \"samples\")\n","    os.makedirs(ckpt_dir, exist_ok=True)\n","    os.makedirs(sample_dir, exist_ok=True)\n","\n","    loader = get_dataloader(root=cfg.data_dir, train=True, batch_size=cfg.batch_size)\n","    text_encoder = FrozenCLIPTextEncoder().to(device)\n","    model = MiniUNet(text_dim=text_encoder.embed_dim).to(device)\n","    scheduler = DDPMScheduler().to(device)\n","    ema = EMA(model, cfg.ema_decay)\n","    optimizer = torch.optim.Adam(model.parameters(), lr=cfg.lr)\n","\n","    step, completed, history = 0, 0, []\n","    latest = os.path.join(ckpt_dir, \"latest.pt\")\n","    if cfg.resume and os.path.exists(latest):\n","        step, completed, history = load_checkpoint(latest, model, ema, optimizer, device)\n","        print(f\"Resumed from epoch {completed} (step {step})\")\n","\n","    print(f\"Device: {device} | trainable params: \"\n","          f\"{sum(p.numel() for p in model.parameters() if p.requires_grad) / 1e6:.2f}M\")\n","\n","    running, count = 0.0, 0\n","    for epoch in range(completed, cfg.epochs):\n","        model.train()\n","        t0 = time.time()\n","        epoch_loss, epoch_batches = 0.0, 0\n","\n","        for images, captions in loader:\n","            images = images.to(device, non_blocking=True)\n","\n","            # Caption dropout -> enables classifier-free guidance at sampling time.\n","            captions = [\"\" if random.random() < cfg.p_uncond else c for c in captions]\n","            _, text_emb = text_encoder(captions)\n","\n","            t = torch.randint(0, scheduler.num_timesteps, (images.size(0),), device=device)\n","            x_t, noise = scheduler.add_noise(images, t)\n","\n","            loss = F.mse_loss(model(x_t, t, text_emb), noise)\n","\n","            optimizer.zero_grad(set_to_none=True)\n","            loss.backward()\n","            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n","            optimizer.step()\n","            ema.update(model)\n","\n","            step += 1\n","            loss_val = loss.item()\n","            running += loss_val; count += 1\n","            epoch_loss += loss_val; epoch_batches += 1\n","\n","            if step % cfg.log_every == 0:\n","                avg = running / count\n","                history.append({\"step\": step, \"epoch\": epoch + 1, \"loss\": avg})\n","                print(f\"epoch {epoch + 1}/{cfg.epochs} | step {step} | loss {avg:.4f}\")\n","                running, count = 0.0, 0\n","\n","        print(f\"== epoch {epoch + 1} done | mean loss {epoch_loss / epoch_batches:.4f} \"\n","              f\"| {time.time() - t0:.0f}s\")\n","\n","        save_checkpoint(latest, model, ema, optimizer, step, epoch + 1, history)\n","\n","        is_last = epoch + 1 == cfg.epochs\n","        if epoch == 0 or (epoch + 1) % cfg.sample_every == 0 or is_last:\n","            generate_grid(ema.model, scheduler, text_encoder, cfg, device,\n","                          os.path.join(sample_dir, f\"epoch_{epoch + 1:03d}.png\"))\n","            save_checkpoint(os.path.join(ckpt_dir, f\"ckpt_epoch{epoch + 1:03d}.pt\"),\n","                            model, ema, optimizer, step, epoch + 1, history)\n","            print(f\"   saved samples + checkpoint for epoch {epoch + 1}\")\n","\n","    with open(os.path.join(cfg.out_dir, \"loss_history.json\"), \"w\") as f:\n","        json.dump(history, f)\n","    if history:\n","        plot_loss(history, path=os.path.join(cfg.out_dir, \"loss_curve.png\"))\n","\n","\n","if __name__ == \"__main__\":\n","    main()"]},{"cell_type":"code","execution_count":16,"id":"8e29678d","metadata":{"execution":{"iopub.execute_input":"2026-11-10T22:37:05.112952Z","iopub.status.busy":"2026-11-10T22:37:05.112303Z","iopub.status.idle":"2026-11-10T22:39:42.724294Z","shell.execute_reply":"2026-11-10T22:39:42.723344Z"},"papermill":{"duration":157.62138,"end_time":"2026-11-10T22:39:42.7